# Framework Configuration for Production Builds
# Copy this file to .env.production and configure as needed
# Set to 'true' to enable, 'false' to disable

VITE_ENABLE_CLIENT_FIRST=true
VITE_ENABLE_LUMOS=true

# --- Observability (optional overrides — shared Codalyn defaults apply when unset) ---
# PostHog — filter by super properties app + environment (production | development | preview)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# Sentry — filter by environment (flint-production, flint-preview, …) or tags app + build_channel
# VITE_SENTRY_DSN=
# Set to 0, false, or off to disable either service locally.

# --- Tower (paid cloud sync). Leave unset to ship Flint fully offline (free tier only). ---
# Tower origin (no trailing slash), e.g. https://tower.codalyn.app. Release builds with an
# unset origin run offline; local http:// origins are rejected unless FLINT_ALLOW_LOCAL_TOWER_IN_PRODUCTION=1.
# VITE_TOWER_ORIGIN=https://tower.codalyn.app
