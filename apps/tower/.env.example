# `next dev` listens on this port (see `next dev --help`, env PORT). Align BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL below.
PORT=3100

# Postgres (Neon in prod, or local/Docker — standard `postgresql://` URL; use 127.0.0.1 not 0.0.0.1)
# Local Docker: host port from `POSTGRES_PORT` in apps/tower/.env — default 35432 (see `.env.compose.example`)
# postgresql://tower:tower@127.0.0.1:35432/tower
DATABASE_URL=

# Better Auth — https://www.better-auth.com/docs/installation (required on Vercel production)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Public URL for the Next app (Better Auth client + CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Shared secret for Beacon → Tower `/api/v1/*` (Authorization: Bearer). Set on Tower only; same value in Beacon VITE_BEACON_API_KEY for dev.
BEACON_API_KEY=

# Webflow — OAuth app (Connect Webflow stores per-user access tokens in the DB; you do not need WEBFLOW_API_TOKEN for that).
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=

# Redirect URI registered on the Webflow app (must match Tower’s public URL)
WEBFLOW_REDIRECT_URI=http://localhost:3100/api/integrations/webflow/callback

# Space-separated scopes for OAuth (must be subset of app settings). Used by GET /api/integrations/webflow/authorize
# WEBFLOW_OAUTH_SCOPES=sites:read sites:write pages:read pages:write cms:read cms:write assets:read assets:write authorized_user:read

# Bearer for POST https://api.webflow.com/beta/token/resolve (scope authorized_user:read). Required until a user has connected Webflow and Tower can use their stored access token.
# Often the same as a Site / Workspace token with that scope. Falls back to WEBFLOW_API_TOKEN if unset.
# WEBFLOW_TOKEN_RESOLVE_BEARER=

# Optional fallback for POST /beta/token/resolve (Designer sign-in) when the user has not connected Webflow yet. Prefer WEBFLOW_TOKEN_RESOLVE_BEARER; this is an alternate env name for the same kind of token.
# WEBFLOW_API_TOKEN=

# Comma-separated extra Origin values allowed for CORS + credentials on /api/v1/* (other extension hosts or staging)
# TOWER_CORS_ORIGINS=https://other-id.webflow-ext.com

# Vercel Blob — optional until uploads are wired
BLOB_READ_WRITE_TOKEN=
