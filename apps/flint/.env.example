# Flint environment template. Copy to .env / .env.development / .env.production as needed.

# --- Linter framework toggles ---
VITE_ENABLE_CLIENT_FIRST=true
VITE_ENABLE_LUMOS=true

# --- Observability (optional; shared Codalyn defaults apply when unset) ---
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# VITE_SENTRY_DSN=

# --- Tower (paid cloud sync). Leave ALL of these unset to run Flint fully offline (free tier). ---
# Tower origin (no trailing slash). Dev default: http://<TOWER_DEV_HOST>:<TOWER_PORT|3100>.
# Release builds with an unset origin run offline; local http:// is rejected in release builds
# unless FLINT_ALLOW_LOCAL_TOWER_IN_PRODUCTION=1.
# VITE_TOWER_ORIGIN=http://localhost:3100
# TOWER_DEV_HOST=localhost
# TOWER_PORT=3100
# Retired: Tower no longer accepts a shared API key (session bearer only). Kept for local experiments; leave unset.
# VITE_FLINT_API_KEY=
