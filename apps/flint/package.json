{
  "name": "@codalyn/flint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/build-cli.mjs --app flint",
    "build:prod": "node ../../scripts/build-cli.mjs --app flint --channel production",
    "build:dev": "node ../../scripts/build-cli.mjs --app flint --channel development",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:all": "pnpm typecheck && pnpm lint",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:structure": "vitest run src/features/linter/rules/client-first/structure/__tests__/",
    "test:class-order": "vitest run src/features/linter/rules/lumos/structure/__tests__/class-order.element.test.ts"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@webflow/designer-extension-typings": "^2.0.33",
    "@webflow/webflow-cli": "^1.15.0",
    "concurrently": "^9.2.1",
    "mini-css-extract-plugin": "^2.10.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@codalyn/observability": "workspace:*",
    "@posthog/react": "^1.9.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/react": "^10.53.1",
    "@tailwindcss/postcss": "^4.2.2",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.10",
    "posthog-js": "^1.369.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  }
}
