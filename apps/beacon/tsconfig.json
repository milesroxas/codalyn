{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types", "../../node_modules/@webflow"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~sb/*": [".storybook/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "exclude": ["node_modules", "dist", "bundle", "storybook-static"]
}
