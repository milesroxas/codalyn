# Copy to `.env.docker` next to docker-compose.yml (never commit real secrets).
# Runtime secrets for the container — same variables as local `.env.local` where applicable.

# Tower app in Docker → Postgres service (hostname `postgres`, internal 5432):
# DATABASE_URL=postgresql://tower:tower@postgres:5432/tower
# Next.js on your host → Postgres published port (see apps/tower/.env POSTGRES_PORT, default 35432):
# DATABASE_URL=postgresql://tower:tower@127.0.0.1:35432/tower
DATABASE_URL=postgresql://tower:tower@postgres:5432/tower
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

BEACON_API_KEY=

# OAuth app — Connect Webflow stores per-user tokens in the DB for the Data API proxy
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3100/api/integrations/webflow/callback
# Designer ID token resolve until a user has OAuth stored (scope authorized_user:read)
# WEBFLOW_TOKEN_RESOLVE_BEARER=
# WEBFLOW_API_TOKEN=
# WEBFLOW_OAUTH_SCOPES=
# TOWER_CORS_ORIGINS=
BLOB_READ_WRITE_TOKEN=
