# Neon Postgres (required at runtime; local `next build` can use a placeholder until you connect a real DB)
DATABASE_URL=

# Better Auth — https://www.better-auth.com/docs/installation (required on Vercel production)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public URL for the Next app (Better Auth client + CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webflow Data API — server-side token for `/api/v1/webflow/*` proxy (Beacon uses Tower, not Webflow directly)
WEBFLOW_API_TOKEN=

# Vercel Blob — optional until uploads are wired
BLOB_READ_WRITE_TOKEN=
