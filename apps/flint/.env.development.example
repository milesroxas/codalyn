# Framework Configuration for Development
# Copy this file to .env.development and configure as needed
# Set to 'true' to enable, 'false' to disable

VITE_ENABLE_CLIENT_FIRST=true
VITE_ENABLE_LUMOS=true

# --- Observability (optional overrides — shared Codalyn defaults apply when unset) ---
# PostHog — filter by super properties app + environment (production | development | preview)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# Sentry — filter by environment (flint-production, flint-preview, …) or tags app + build_channel
# VITE_SENTRY_DSN=
# Set to 0, false, or off to disable either service locally.

# --- Tower (paid cloud sync). Leave ALL of these unset to run Flint fully offline (free tier). ---
# Tower origin (no trailing slash). When unset in dev, the bundle defaults to
# http://<TOWER_DEV_HOST>:<port> where port is TOWER_PORT, else Tower apps/tower/.env PORT, else 3100.
# VITE_TOWER_ORIGIN=http://localhost:3100
# TOWER_DEV_HOST=localhost
# TOWER_PORT=3100
# Retired: Tower no longer accepts a shared API key (session bearer only). Kept for local experiments; leave unset.
# Prefer signing in via Webflow in the extension (Designer session bearer).
# VITE_FLINT_API_KEY=
