{
  "name": "codalyn",
  "version": "0.0.0",
  "private": true,
  "description": "Codalyn monorepo — Webflow product suite (Flint, Beacon, Loadout) and Tower dashboard.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "patchedDependencies": {
      "vaul@1.1.2": "patches/vaul@1.1.2.patch",
      "react-style-singleton@2.2.3": "patches/react-style-singleton@2.2.3.patch",
      "@radix-ui/react-select@2.2.6": "patches/@radix-ui__react-select@2.2.6.patch",
      "@radix-ui/react-scroll-area@1.2.10": "patches/@radix-ui__react-scroll-area@1.2.10.patch",
      "react-easy-crop@5.5.7": "patches/react-easy-crop@5.5.7.patch",
      "@lexical/link@0.46.0": "patches/@lexical__link@0.46.0.patch",
      "posthog-js@1.369.3": "patches/posthog-js@1.369.3.patch",
      "scheduler@0.27.0": "patches/scheduler@0.27.0.patch",
      "@radix-ui/react-focus-scope@1.1.7": "patches/@radix-ui__react-focus-scope@1.1.7.patch",
      "react-router@7.18.3": "patches/react-router@7.18.3.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ],
    "overrides": {
      "pg": "8.20.0",
      "import-in-the-middle": "3.0.1",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "scripts": {
    "app": "node scripts/app.mjs",
    "prepare": "simple-git-hooks",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook --filter=@codalyn/beacon",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter=@codalyn/loadout && changeset publish",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^2.31.0",
    "@clack/prompts": "^1.6.0",
    "chokidar": "^5.0.0",
    "lightningcss": "1.32.0",
    "lint-staged": "^17.0.7",
    "picocolors": "^1.1.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
