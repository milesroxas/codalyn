{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", "biome.json", ".env"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "BLOB_READ_WRITE_TOKEN",
    "BUILD_RECIPIENT",
    "DATABASE_URL_UNPOOLED",
    "NEON_PROJECT_ID",
    "PGDATABASE",
    "PGHOST",
    "PGHOST_UNPOOLED",
    "PGPASSWORD",
    "PGUSER",
    "POSTGRES_DATABASE",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_USER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/**", ".next/**", "!.next/cache/**"],
      "env": [
        "VITE_*",
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "VERCEL_ENV",
        "BEACON_API_KEY",
        "WEBFLOW_API_TOKEN",
        "WEBFLOW_CLIENT_ID",
        "WEBFLOW_CLIENT_SECRET",
        "WEBFLOW_REDIRECT_URI",
        "WEBFLOW_OAUTH_SCOPES",
        "TOWER_CORS_ORIGINS",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "TOWER_APP_HOST",
        "TOWER_HOST_SPLIT",
        "TOWER_MARKETING_HOSTS",
        "TOWER_MARKETING_URL"
      ],
      "passThroughEnv": [
        "RESEND_API_KEY",
        "RESEND_FROM",
        "STRIPE_PRICE_PRO",
        "STRIPE_PRICE_STUDIO",
        "STRIPE_PRICE_TEAM_SEAT",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "TOWER_BILLING_ENABLED",
        "TOWER_EARLY_ACCESS_GATE",
        "TOWER_TEAM_MIN_SEATS"
      ]
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/**"],
      "env": ["VITE_*"]
    },
    "build:prod": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:run": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
