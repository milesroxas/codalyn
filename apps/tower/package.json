{
  "name": "@codalyn/tower",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tower — Codalyn backend + dashboard (Next.js on Vercel). Webflow Data API proxy for Beacon; image pipeline.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:neon": "node scripts/dev.mjs dev",
    "dev:preview": "node scripts/dev.mjs preview",
    "build": "rm -f .next/cache/.tsbuildinfo && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-journal-check.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "node scripts/db-migrate.mjs local",
    "db:migrate:dev": "node scripts/db-migrate.mjs dev",
    "db:migrate:preview": "node scripts/db-migrate.mjs preview",
    "db:migrate:prod": "node scripts/db-migrate.mjs prod",
    "db:migrate:dev:vercel": "node scripts/db-migrate.mjs dev --vercel",
    "db:migrate:preview:vercel": "node scripts/db-migrate.mjs preview --vercel",
    "db:migrate:prod:vercel": "node scripts/db-migrate.mjs prod --vercel",
    "db:reset:local": "node scripts/db-reset-local.mjs",
    "db:seed:local": "node scripts/db-seed-local-operators.mjs",
    "db:beacon-preset-storage-migrate:local": "node scripts/db-beacon-preset-storage-migrate.mjs local",
    "db:beacon-preset-storage-migrate:dev": "node scripts/db-beacon-preset-storage-migrate.mjs dev",
    "db:beacon-preset-storage-migrate:preview": "node scripts/db-beacon-preset-storage-migrate.mjs preview",
    "db:beacon-preset-storage-migrate:prod": "node scripts/db-beacon-preset-storage-migrate.mjs prod",
    "db:beacon-preset-storage-migrate:dev:vercel": "node scripts/db-beacon-preset-storage-migrate.mjs dev --vercel",
    "db:beacon-preset-storage-migrate:preview:vercel": "node scripts/db-beacon-preset-storage-migrate.mjs preview --vercel",
    "db:beacon-preset-storage-migrate:prod:vercel": "node scripts/db-beacon-preset-storage-migrate.mjs prod --vercel",
    "db:studio": "drizzle-kit studio",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "payload:migrate": "node scripts/payload-migrate.mjs local",
    "payload:migrate:dev": "node scripts/payload-migrate.mjs dev",
    "payload:migrate:preview": "node scripts/payload-migrate.mjs preview",
    "payload:migrate:prod": "node scripts/payload-migrate.mjs prod",
    "payload:migrate:dev:vercel": "node scripts/payload-migrate.mjs dev --vercel",
    "payload:migrate:preview:vercel": "node scripts/payload-migrate.mjs preview --vercel",
    "payload:migrate:prod:vercel": "node scripts/payload-migrate.mjs prod --vercel",
    "payload:migrate:create": "payload migrate:create",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@c15t/nextjs": "^2.1.0",
    "@codalyn/observability": "workspace:*",
    "@codalyn/webflow-kit": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@paper-design/shaders-react": "0.0.76",
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-vercel-blob": "^3.86.0",
    "@posthog/react": "^1.10.2",
    "@sentry/nextjs": "^10.59.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^1.1.1",
    "better-auth": "^1.6.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "hls.js": "^1.6.16",
    "import-in-the-middle": "3.0.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.21.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "payload": "^3.86.0",
    "pg": "^8.22.0",
    "posthog-js": "^1.391.2",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "require-in-the-middle": "8.0.1",
    "resend": "^6.14.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.15",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
