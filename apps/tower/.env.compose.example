# Codalyn Tower — copy to `.env` in this directory (gitignored).
# Docker Compose reads `.env` for ${POSTGRES_PORT} / ${TOWER_PORT} substitution.
# These defaults are reserved for this stack only; change if a port is already taken.
#
# TOWER_PORT: published host port for the containerized Next app. Default 3100 matches
# `pnpm app tower dev`, so you cannot run the full stack and dev on 3100 at once.
# Typical HMR workflow: keep dev on 3100 and run `docker compose up -d postgres` only,
# or set TOWER_PORT=3101 (and align apps/tower/.env.docker URLs) if you need both.

POSTGRES_PORT=35432
TOWER_PORT=3100
