{
  "name": "@codalyn/beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node ../../scripts/build-cli.mjs --app beacon",
    "build:prod": "node ../../scripts/build-cli.mjs --app beacon --channel production",
    "build:preview": "node ../../scripts/build-cli.mjs --app beacon --channel preview",
    "build:dev": "node ../../scripts/build-cli.mjs --app beacon --channel development",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/assert-no-biome-ignore.mjs",
    "lint:fix": "biome check --write .",
    "lint:all": "pnpm typecheck && pnpm lint",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/expect": "4.1.4",
    "@webflow/designer-extension-typings": "^2.0.33",
    "@webflow/webflow-cli": "^1.15.0",
    "jsdom": "^29.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@codalyn/observability": "workspace:*",
    "@codalyn/webflow-kit": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@sentry/react": "^10.53.1",
    "@tabler/icons-react": "^3.41.1",
    "better-auth": "1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "posthog-js": "^1.369.3",
    "radix-ui": "^1.4.3",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "^7.14.2",
    "shadcn": "^4.3.0",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}
