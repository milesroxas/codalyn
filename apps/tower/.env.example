# `next dev` listens on this port (see `next dev --help`, env PORT). Align BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL below.
PORT=3100

# Postgres (Neon in prod, or local/Docker — standard `postgresql://` URL; use 127.0.0.1 not 0.0.0.0)
# Local Docker: host port from `POSTGRES_PORT` in apps/tower/.env — default 35432 (see `.env.compose.example`)
# postgresql://tower:tower@127.0.0.1:35432/tower
# Required for drizzle-kit push | generate | migrate | studio (see drizzle/README.md)
DATABASE_URL=

# --- Optional: `pnpm db:migrate:*` (see scripts/db-migrate.mjs) ---
# Prefer branch + API key over pasting full URLs (easier rotation). Gitignored overrides in `.env.local` only.
# Neon CLI auth: set NEON_API_KEY here (read by neonctl via env — never pass on argv) or run `npx neonctl auth`.
# NEON_PROJECT_ID=
# NEON_API_KEY=
# TOWER_NEON_BRANCH_DEV=development
# TOWER_NEON_BRANCH_PREVIEW=preview
# TOWER_NEON_BRANCH_PROD=
# Optional full URL overrides (discouraged): TOWER_DATABASE_URL_DEV=  TOWER_DATABASE_URL_PREVIEW=  TOWER_DATABASE_URL_PROD=
# `--vercel` scripts ignore all TOWER_* overrides and use Vercel env pull only.
# Prod migrations require `--confirm` (or TOWER_DB_MIGRATE_CONFIRM=1 in CI). Non-Neon prod hosts need TOWER_DB_ALLOW_NON_NEON=1.

# Better Auth — https://www.better-auth.com/docs/installation (required on Vercel production)
BETTER_AUTH_SECRET=
# Production: Tower app subdomain (auth, dashboard, APIs). Marketing homepage uses codalyn.app — see TOWER_* host vars below.
BETTER_AUTH_URL=http://localhost:3100

# Public URL for the Next app (Better Auth client + CORS). Production: match BETTER_AUTH_URL (tower.codalyn.app).
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Host split (production): codalyn.app = marketing, tower.codalyn.app = app ---
# Auto-enabled when BETTER_AUTH_URL host starts with `tower.` or `tower-` (e.g. tower-preview). Override with TOWER_HOST_SPLIT=0|1.
# TOWER_HOST_SPLIT=1
# Comma-separated marketing hosts (default: codalyn.app,www.codalyn.app)
# TOWER_MARKETING_HOSTS=codalyn.app,www.codalyn.app
# Canonical marketing origin (default: https://codalyn.app). Used for marketing CTAs only.
# TOWER_MARKETING_URL=https://codalyn.app
# App subdomain hostname when it differs from BETTER_AUTH_URL (default: derived from BETTER_AUTH_URL)
# TOWER_APP_HOST=tower.codalyn.app
# Shared session cookie parent domain — production only; must match parent of TOWER_APP_HOST (default: codalyn.app).
# TOWER_COOKIE_DOMAIN=codalyn.app

# --- Observability (optional overrides — shared Codalyn defaults apply when unset) ---
# PostHog — filter by super property app=tower
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# Sentry — filter by tag app=tower
# NEXT_PUBLIC_SENTRY_DSN=
# Set to 0, false, or off to disable either service locally.
# Source map upload in CI (keep secret; never commit)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Shared secret for Beacon → Tower `/api/v1/*` (Authorization: Bearer). Set on Tower only; same value in Beacon VITE_BEACON_API_KEY for dev.
BEACON_API_KEY=

# CMS Slots layout APIs (/api/v1/beacon/cms-layout/* gate). Production: set to exactly "true".
# NEXT_PUBLIC_CMS_SLOTS_SURFACE_ENABLED=true

# Webflow — OAuth app (Connect Webflow stores per-user access tokens in the DB; you do not need WEBFLOW_API_TOKEN for that).
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=

# OAuth redirect override (optional): defaults to `${NEXT_PUBLIC_APP_URL}/api/integrations/webflow/callback` when unset.
# Local dev: localhost URL below; production deploy: your https Tower origin only — never point local Tower at a prod redirect URI (or Webflow returns users to prod).
# Register both URLs on the Webflow OAuth app if you use one client id for dev and prod.
WEBFLOW_REDIRECT_URI=http://localhost:3100/api/integrations/webflow/callback

# Space-separated scopes for OAuth (must be subset of app settings). Used by GET /api/integrations/webflow/authorize
# WEBFLOW_OAUTH_SCOPES=sites:read pages:read cms:read cms:write assets:read assets:write custom_code:read custom_code:write authorized_user:read

# Bearer for POST https://api.webflow.com/beta/token/resolve (scope authorized_user:read). Required until a user has connected Webflow and Tower can use their stored access token.
# Often the same as a Site / Workspace token with that scope. Falls back to WEBFLOW_API_TOKEN if unset.
# WEBFLOW_TOKEN_RESOLVE_BEARER=

# Optional fallback for POST /beta/token/resolve (Designer sign-in) when the user has not connected Webflow yet. Prefer WEBFLOW_TOKEN_RESOLVE_BEARER; this is an alternate env name for the same kind of token.
# WEBFLOW_API_TOKEN=

# Comma-separated extra Origin values allowed for CORS + credentials on /api/* (other extension hosts or staging).
# Webflow Designer hosts (*.webflow-ext.com, *.design.webflow.com) are allowed automatically.
# TOWER_CORS_ORIGINS=https://other-id.webflow-ext.com
#
# Preview (tower-preview.codalyn.app): Vercel Deployment Protection blocks Beacon cross-origin /api/* calls
# unless the preview domain has a Deployment Protection Exception (Vercel → Project → Deployment Protection).
# Match Beacon VITE_TOWER_ORIGIN to the Tower origin you use; production bundles default to tower.codalyn.app.

# Comma-separated emails: `syncProductAdminRolesFromEnv` sets `user.role = product_admin` (first GET /api/health per process; user rows must exist). Admin APIs require DB role `product_admin` only (no env bypass at runtime).
# TOWER_PRODUCT_ADMIN_EMAILS=

# Early access gate — off by default. When enabled, sign-up/sign-in require operator invite, team invite, or `user.early_access_granted_at`.
# TOWER_EARLY_ACCESS_GATE=1

# Resend — transactional email (team/operator invites, verification). Omit RESEND_API_KEY locally to skip sends.
# Production: set both. RESEND_FROM must be a verified domain/sender in Resend (bare address or Name <addr>).
# Inbox display name is always "Miles at Codalyn" (see resend-send.ts).
# RESEND_API_KEY=
# RESEND_FROM=mail@yourdomain.com

# Vercel Blob — optional until uploads are wired
BLOB_READ_WRITE_TOKEN=

# --- Stripe (optional — billing & usage caps) ---
# `pnpm app tower db:migrate:prod` after adding `0004_tower_billing_usage` columns.
# Off by default: omit or set 0. Set to 1 / true to enable Checkout, webhooks, portal, and /billing.
# TOWER_BILLING_ENABLED=1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=  # from `stripe listen` locally; from Stripe Dashboard → webhooks in prod
# STRIPE_PRICE_PRO=       # Price id (recurring) for the Pro product
# STRIPE_PRICE_TEAM_SEAT= # Per-seat recurring Price id for workspace (Team) billing
# TOWER_TEAM_MIN_SEATS=2  # Minimum seats on team checkout and Stripe quantity sync
# TOWER_METERING_DISABLED=1  # deploy emergency only: forces metering off regardless of Operator settings
# Seed values for the first platform row only (Operator Platform UI is the runtime source of truth after migrate):
# TOWER_FREE_WEBFLOW_PROXY_REQUESTS_PER_MONTH=2500
# TOWER_FREE_CMS_WRITES_PER_MONTH=500
# TOWER_FREE_IMAGE_OPTIMIZES_PER_MONTH=50
# TOWER_PRO_WEBFLOW_PROXY_REQUESTS_PER_MONTH=150000
# TOWER_PRO_CMS_WRITES_PER_MONTH=50000
# TOWER_PRO_IMAGE_OPTIMIZES_PER_MONTH=10000
