{
  "name": "@codalyn/beacon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-cli.js",
    "build:prod": "tsc && vite build --mode production && webflow extension bundle && mkdir -p bundle/prod/${VITE_BUNDLE_RECIPIENT:-internal} && mv bundle.zip bundle/prod/${VITE_BUNDLE_RECIPIENT:-internal}/v$(node -p \"require('./package.json').version\")_${VITE_BUNDLE_RECIPIENT:-internal}_$(date +'%m-%d_%H-%M-%S').zip",
    "build:dev": "tsc && vite build --mode development && webflow extension bundle && mkdir -p bundle/development/${VITE_BUNDLE_RECIPIENT:-internal} && mv bundle.zip bundle/development/${VITE_BUNDLE_RECIPIENT:-internal}/v$(node -p \"require('./package.json').version\")_${VITE_BUNDLE_RECIPIENT:-internal}_$(date +'%m-%d_%H-%M-%S').zip",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/assert-no-biome-ignore.mjs",
    "lint:fix": "biome check --write .",
    "lint:all": "pnpm typecheck && pnpm lint",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@clack/prompts": "^1.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@webflow/designer-extension-typings": "^2.0.33",
    "picocolors": "^1.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@jsquash/avif": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react-easy-crop": "^5.5.7",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}
