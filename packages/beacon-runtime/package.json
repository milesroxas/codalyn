{
  "name": "@codalyn/beacon-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beacon runtime script. Reads composition JSON from a CMS-bound slot attribute, clones components from a hidden bank, applies overrides, and injects into the slot.",
  "main": "./dist/beacon-runtime.iife.js",
  "module": "./dist/beacon-runtime.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/beacon-runtime.js"
    },
    "./iife": "./dist/beacon-runtime.iife.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist .turbo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
