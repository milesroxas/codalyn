# Framework Configuration for Development
# Copy this file to .env.development and configure as needed
# Set to 'true' to enable, 'false' to disable

VITE_ENABLE_CLIENT_FIRST=true
VITE_ENABLE_LUMOS=true

# --- Observability (optional overrides — shared Codalyn defaults apply when unset) ---
# PostHog — filter by super property app=flint
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# Sentry — filter by tag app=flint
# VITE_SENTRY_DSN=
# Set to 0, false, or off to disable either service locally.
