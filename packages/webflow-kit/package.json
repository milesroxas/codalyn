{
  "name": "@codalyn/webflow-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Webflow Data API + image pipeline constants for Codalyn apps (Tower, Beacon).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@tabler/icons-react": ">=3.0.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@tabler/icons-react": "^3.41.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "jsdom": "^29.0.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
