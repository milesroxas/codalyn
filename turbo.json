{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", "biome.json", ".env"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "BLOB_READ_WRITE_TOKEN",
    "NEON_PROJECT_ID",
    "PGHOST_UNPOOLED",
    "PGPASSWORD",
    "PGUSER",
    "POSTGRES_DATABASE",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_USER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/**", ".next/**", "!.next/cache/**"],
      "env": [
        "VITE_*",
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "VERCEL_ENV",
        "BEACON_API_KEY",
        "WEBFLOW_API_TOKEN",
        "WEBFLOW_CLIENT_ID",
        "WEBFLOW_CLIENT_SECRET",
        "WEBFLOW_REDIRECT_URI",
        "WEBFLOW_OAUTH_SCOPES",
        "TOWER_CORS_ORIGINS"
      ]
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/**"],
      "env": ["VITE_*"]
    },
    "build:prod": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:run": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
